# Copy to .env.local and fill in. Never commit .env.local.

# Needed for live mode (analysing documents with Claude). Replay mode works without it.
ANTHROPIC_API_KEY=

# Public demo deploys: set either flag to 1 and the app serves the recorded run only.
# NEXT_PUBLIC_REPLAY_ONLY is read by the browser bundle (hides live mode) and the server;
# CROSSCHECK_REPLAY_ONLY is server-only and refuses live calls and uploads regardless of the bundle.
# NEXT_PUBLIC_REPLAY_ONLY=1
# CROSSCHECK_REPLAY_ONLY=1

# Optional: another Claude model. Cost figures assume claude-opus-5-5.
# CROSSCHECK_MODEL=claude-opus-5-5
