# Copy to .env.local and fill in. Never commit .env.local.

# Needed for live mode (analysing documents with Claude). Replay mode works without it.
ANTHROPIC_API_KEY=

# Replay-only mode serves the recorded run and refuses live calls and uploads. Production builds are
# replay-only by default (.env.production sets NEXT_PUBLIC_REPLAY_ONLY=1); set it to 0 in the deploy
# environment to run live there. NEXT_PUBLIC_REPLAY_ONLY is read by the browser bundle (hides live mode)
# and the server; CROSSCHECK_REPLAY_ONLY is server-only and refuses live calls regardless of the bundle.
# NEXT_PUBLIC_REPLAY_ONLY=1
# CROSSCHECK_REPLAY_ONLY=1

# Optional: another Claude model. Cost figures assume claude-opus-5-5.
# CROSSCHECK_MODEL=claude-opus-5-5
