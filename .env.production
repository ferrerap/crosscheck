# Loaded by `next build` and `next start`, so every production build is replay-only by default: the browser
# hides live mode and the server refuses live calls and uploads. A deploy environment that sets
# NEXT_PUBLIC_REPLAY_ONLY=0 (and provides ANTHROPIC_API_KEY) overrides this. `npm run dev` does not read this file.
NEXT_PUBLIC_REPLAY_ONLY=1
